
/* ==================================================
   CEEQWINN DIALOGUE MVP — AUTOPLAY v1
   Independent Theatre 2 stylesheet
   ================================================== */

.dialogue-autoplay-v1 {
  --auto-gold: #c9a45e;
  --auto-gold-light: #f1dca6;
  --auto-pearl: #fff8ed;
  --auto-muted: #c4b7b7;

  width: 100%;
  max-width: 480px;
  margin: 48px auto 24px;
  padding: 12px;
  color: var(--auto-pearl);
  font-family: Georgia, "Times New Roman", serif;
}

.dialogue-autoplay-v1 *,
.dialogue-autoplay-v1 *::before,
.dialogue-autoplay-v1 *::after {
  box-sizing: border-box;
}

.dialogue-autoplay-v1 button {
  font: inherit;
}

.dialogue-autoplay-v1 button:focus-visible {
  outline: 2px solid var(--auto-gold-light);
  outline-offset: 4px;
}

.autoplay-heading {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 12px;
  color: var(--auto-gold-light);
  font: 9px/1.5 Arial, sans-serif;
  letter-spacing: 0.15em;
}

.autoplay-stage {
  position: relative;
  width: 100%;
  height: min(780px, 86vh);
  height: min(780px, 86svh);
  min-height: 520px;
  overflow: hidden;
  isolation: isolate;
  border: 1px solid rgba(201, 164, 94, 0.4);
  border-radius: 4px;
  background: #1b1217;
}

.autoplay-image {
  position: absolute;
  z-index: -1;
  inset: 0;
  background-position: center 25%;
  background-repeat: no-repeat;
  background-size: contain;
  opacity: 1;
  transition: opacity 500ms ease;
}

.autoplay-image.is-changing {
  opacity: 0;
}

.autoplay-shade {
  position: absolute;
  z-index: 0;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(13, 8, 11, 0.35),
    transparent 25%,
    transparent 48%,
    rgba(13, 8, 11, 0.78) 100%
  );
}

.autoplay-caption {
  position: absolute;
  z-index: 1;
  top: 20px;
  left: 16px;
  right: 16px;
  color: rgba(255, 245, 231, 0.85);
  font-size: 13px;
  font-style: italic;
  line-height: 1.5;
  text-shadow: 0 2px 10px #000;
  pointer-events: none;
}

/* ------------------------------------------
   Dialogue glass
   ------------------------------------------ */

.autoplay-glass {
  position: absolute;
  z-index: 3;
  right: 12px;
  bottom: 65px;
  left: 12px;
  min-width: 0;
  padding: 16px;
  border: 1px solid rgba(201, 164, 94, 0.48);
  border-radius: 3px;
  background: rgba(30, 17, 23, 0.88);
  box-shadow: 0 12px 34px rgba(0, 0, 0, 0.25);
}

@supports (backdrop-filter: blur(8px)) {
  .autoplay-glass {
    background: rgba(30, 17, 23, 0.72);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
}

.autoplay-speaker {
  margin-bottom: 10px;
  color: var(--auto-gold-light);
  font: 700 10px/1.5 Arial, sans-serif;
  letter-spacing: 0.2em;
}

.autoplay-text {
  min-height: 3.15em;
  margin: 0;
  color: var(--auto-pearl);
  font-size: 19px;
  line-height: 1.57;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.autoplay-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 14px;
  padding-top: 10px;
  border-top: 1px solid rgba(255, 235, 195, 0.12);
  color: rgba(255, 245, 229, 0.68);
  font: 9px/1.5 Arial, sans-serif;
  letter-spacing: 0.1em;
}

/* ------------------------------------------
   Continue button
   ------------------------------------------ */

.autoplay-advance {
  position: absolute;
  z-index: 5;
  right: 15px;
  bottom: 14px;
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  padding: 0 0 4px 2px;
  border: 1px solid rgba(217, 184, 121, 0.65);
  border-radius: 50%;
  color: var(--auto-gold-light);
  background: rgba(25, 15, 20, 0.88);
  font-size: 29px;
  line-height: 1;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.autoplay-advance:active {
  background: rgba(104, 61, 69, 0.9);
  transform: scale(0.96);
}

/* ------------------------------------------
   Temporary silent reaction portrait
   ------------------------------------------ */

.dialogue-autoplay-v1 .autoplay-reaction {
  position: absolute;
  z-index: 2;
  top: 20%;
  left: 12px;
  width: 82px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(7px);
  transition:
    opacity 220ms ease,
    transform 220ms ease,
    visibility 220ms ease;
  pointer-events: none;
}

.dialogue-autoplay-v1 .autoplay-reaction.is-visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.autoplay-reaction-frame {
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border: 1px solid var(--auto-gold);
  background: #21151a;
  box-shadow: 0 7px 22px rgba(0, 0, 0, 0.35);
}

.autoplay-reaction-frame img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 24%;
}

.autoplay-reaction-name {
  display: block;
  margin-top: 6px;
  color: var(--auto-gold-light);
  font: 9px/1.4 Arial, sans-serif;
  letter-spacing: 0.1em;
  text-shadow: 0 1px 7px #000;
}

/* ------------------------------------------
   PRESENT — circular character portraits
   ------------------------------------------ */

.autoplay-present {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  padding: 13px 3px 3px;
}

.autoplay-present-label {
  flex: 0 0 auto;
  color: rgba(255, 239, 216, 0.55);
  font: 8px/1.5 Arial, sans-serif;
  letter-spacing: 0.17em;
}

.autoplay-portrait-list {
  display: flex;
  flex: 1 1 150px;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  min-width: 0;
}

.autoplay-portrait {
  display: flex;
  align-items: center;
  gap: 7px;
  min-width: 0;
  padding: 0;
  border: 0;
  color: var(--auto-muted);
  background: transparent;
  font: inherit;
}

.autoplay-portrait img {
  display: block;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  border: 1px solid rgba(201, 164, 94, 0.35);
  border-radius: 50%;
  object-fit: cover;
  object-position: center 25%;
  background: #26171e;
  transition:
    border-color 180ms ease,
    box-shadow 180ms ease;
}

.autoplay-portrait.is-speaking img {
  border-color: var(--auto-gold-light);
  box-shadow: 0 0 0 2px rgba(201, 164, 94, 0.17);
}

.autoplay-portrait span {
  font: 10px/1.4 Arial, sans-serif;
  white-space: nowrap;
}

.autoplay-portrait.is-speaking span {
  color: var(--auto-gold-light);
}

/* ------------------------------------------
   Status and restart
   ------------------------------------------ */

.autoplay-status {
  padding-top: 12px;
  color: rgba(255, 238, 214, 0.58);
  font: 9px/1.5 Arial, sans-serif;
  letter-spacing: 0.1em;
  text-align: center;
}

.autoplay-restart {
  display: block;
  margin: 7px 0 0 auto;
  padding: 6px 0;
  border: 0;
  color: rgba(255, 238, 214, 0.76);
  background: transparent;
  font: 11px Arial, sans-serif;
  cursor: pointer;
}

.autoplay-restart:hover {
  color: var(--auto-gold-light);
}

/* ------------------------------------------
   Smaller phones
   ------------------------------------------ */

@media (max-width: 360px) {
  .dialogue-autoplay-v1 {
    padding: 6px;
  }

  .autoplay-stage {
    min-height: 500px;
  }

  .autoplay-glass {
    right: 8px;
    left: 8px;
    padding: 13px;
  }

  .autoplay-text {
    font-size: 17px;
  }

  .dialogue-autoplay-v1 .autoplay-reaction {
    left: 9px;
    width: 68px;
  }

  .autoplay-present {
    gap: 9px;
  }

  .autoplay-portrait-list {
    gap: 9px;
  }

  .autoplay-portrait img {
    width: 30px;
    height: 30px;
    flex-basis: 30px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .dialogue-autoplay-v1 *,
  .dialogue-autoplay-v1 *::before,
  .dialogue-autoplay-v1 *::after {
    transition: none !important;
  }
}
